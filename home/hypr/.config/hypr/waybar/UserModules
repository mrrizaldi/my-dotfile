/* Waybar Modules Extras */

/* This is where you can add Extra Modules you wish. copy.sh will try to restore*/
/* this file along with the unique configs and styles. */
/* IMPORTANT, be mindful with , or ". else waybar will not start */

{
/* Per-monitor workspaces (pairs with UserConfigs/user_keybinds.lua "UserWs"):
   eDP-1 owns IDs 1-10, the external monitor 11-20. Each bar shows only its own
   monitor and labels 11-20 the same as 1-10, so both screens count 一..十. */
"hyprland/workspaces#permon": {
	"disable-scroll": true,
	"show-special": false,
	"all-outputs": false,
	"format": "{icon}",
	"persistent-workspaces": {
		"eDP-1": [1, 2, 3, 4, 5],
		"HDMI-A-1": [11, 12, 13, 14, 15]
	},
	"format-icons": {
		"1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
		"6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
		"11": "一", "12": "二", "13": "三", "14": "四", "15": "五",
		"16": "六", "17": "七", "18": "八", "19": "九", "20": "十"
	}
}
}
